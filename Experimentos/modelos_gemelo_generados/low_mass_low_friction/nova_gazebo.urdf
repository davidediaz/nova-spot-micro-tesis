      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.42</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.84</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/pavilion/Documentos/Cuadrupedo/install/nova_sm3_description/share/nova_sm3_description/config/controllers.yaml</parameters>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
