        "-framerate",
        "30"
      ],
      "salida": [
        "-c:v",
        "mjpeg",
        "-q:v",
        "4"
      ],
      "previo": [
        "exposure_dynamic_framerate=0"
      ]
    },
    {
      "nombre": "celular",
      "dispositivo": "/dev/video0",
