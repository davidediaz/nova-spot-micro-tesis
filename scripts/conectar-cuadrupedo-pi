#!/bin/bash
# ProxyCommand para `ssh cuadrupedo-pi`: encuentra la Raspberry del cuadrúpedo y
# conecta. Prueba en orden: nombre mDNS, última IP conocida, túnel inverso de la
# Pi (localhost:2222) y, si nada responde, escanea las redes /24 del PC. Solo
# acepta un equipo cuya clave ED25519 coincida con la huella de la Pi.
HUELLA="SHA256:mTERAysLSgm2Xlw36tOoV0uv5gC3vj7Xoycel2xe16M"
CACHE="$HOME/.cache/cuadrupedo-pi-ip"
PUERTO="${1:-22}"

es_la_pi() {  # $1 host, $2 puerto
  timeout 4 ssh-keyscan -T 3 -p "$2" -t ed25519 "$1" 2>/dev/null \
    | ssh-keygen -lf - 2>/dev/null | grep -q "$HUELLA"
}
abierto() { timeout 1.5 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null; }
usar() { echo "$1 $2" > "$CACHE"; exec nc "$1" "$2"; }

candidatos=()
ip_mdns=$(timeout 3 getent ahostsv4 cuadrupedo-pi.local 2>/dev/null | awk 'NR==1{print $1}')
[ -n "$ip_mdns" ] && candidatos+=("$ip_mdns $PUERTO")
[ -s "$CACHE" ] && candidatos+=("$(cat "$CACHE")")
candidatos+=("127.0.0.1 2222")
for c in "${candidatos[@]}"; do
  set -- $c
  abierto "$1" "$2" && es_la_pi "$1" "$2" && usar "$1" "$2"
done
# Escaneo de las redes del PC (solo /24 privadas).
for red in $(ip -4 -o addr show scope global | awk '{print $4}' | grep '/24$' | cut -d. -f1-3); do
  for i in $(seq 1 254); do
    ( abierto "$red.$i" "$PUERTO" && echo "$red.$i" ) &
  done
  wait
done 2>/dev/null | while read h; do
  es_la_pi "$h" "$PUERTO" && { echo "$h $PUERTO" > "$CACHE"; echo "$h"; break; }
done > "$CACHE.encontrada"
if [ -s "$CACHE.encontrada" ]; then usar "$(cat "$CACHE.encontrada")" "$PUERTO"; fi
echo "No se encontró la Raspberry del cuadrúpedo en ninguna red ni por el túnel." >&2
exit 1
