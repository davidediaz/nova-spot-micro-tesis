"""Control mínimo del PCA9685 con apagado predeterminado y OE físico.

Este módulo no mueve servos por sí solo. Requiere Raspberry Pi, I2C habilitado
y python3-smbus. OE físico es opcional, usa numeración BCM y es activo en bajo.
"""

from math import pi
from time import sleep


MODE1 = 0x00
PRESCALE = 0xFE
LED0_ON_L = 0x06
ALL_LED_OFF_H = 0xFD
FULL_OFF = 0x10


class PCA9685Seguro:
    def __init__(self, bus_number=1, address=0x40, frequency_hz=50,
                 oe_bcm_gpio=17):
        try:
            from smbus import SMBus
        except ImportError as error:
            raise RuntimeError(
                "Falta python3-smbus; instalarlo en la Raspberry") from error

        self._gpio = None
        self._oe_pin = None
        if oe_bcm_gpio is not None:
            try:
                import RPi.GPIO as GPIO
            except ImportError as error:
                raise RuntimeError("RPi.GPIO es necesario cuando se usa OE") from error
            self._gpio = GPIO
            self._oe_pin = int(oe_bcm_gpio)
            GPIO.setwarnings(False)
            GPIO.setmode(GPIO.BCM)
            GPIO.setup(self._oe_pin, GPIO.OUT, initial=GPIO.HIGH)
        self._bus = SMBus(int(bus_number))
        self.address = int(address)
        self.frequency_hz = float(frequency_hz)
        self.armed = False
        self.all_off()
        self._set_frequency(self.frequency_hz)

    def _write(self, register, value):
        last_error = None
        for _ in range(3):
            try:
                self._bus.write_byte_data(self.address, register, value & 0xFF)
                return
            except OSError as error:
                last_error = error
                sleep(0.02)
        raise last_error

    def _read(self, register):
        last_error = None
        for _ in range(3):
            try:
                return self._bus.read_byte_data(self.address, register)
            except OSError as error:
                last_error = error
                sleep(0.02)
        raise last_error

    def _write_block(self, register, values):
        last_error = None
        for _ in range(3):
            try:
                self._bus.write_i2c_block_data(
                    self.address, register, [int(value) & 0xFF for value in values])
                return
            except OSError as error:
                last_error = error
                sleep(0.02)
        raise last_error

    def _set_frequency(self, frequency_hz):
        prescale = round(25_000_000 / (4096 * frequency_hz)) - 1
        old_mode = self._read(MODE1)
        self._write(MODE1, (old_mode & 0x7F) | 0x10)
        self._write(PRESCALE, prescale)
        # Nunca restaure SLEEP desde un estado anterior/interrumpido: el
        # oscilador debe despertar antes de habilitar RESTART y auto-incremento.
        awake_mode = old_mode & 0x6F
        self._write(MODE1, awake_mode)
        sleep(0.005)
        self._write(MODE1, awake_mode | 0xA1)

    def all_off(self):
        self._write(ALL_LED_OFF_H, FULL_OFF)
        if self._gpio is not None:
            self._gpio.output(self._oe_pin, self._gpio.HIGH)
        self.armed = False

    def arm(self):
        # Quita FULL_OFF antes de bajar OE. La llamada debe estar protegida por
        # calibración, parada física y confirmación en la capa superior.
        self._write(ALL_LED_OFF_H, 0x00)
        if self._gpio is not None:
            self._gpio.output(self._oe_pin, self._gpio.LOW)
        self.armed = True

    def _write_pulse_us(self, channel, pulse_us):
        if not 0 <= int(channel) <= 15:
            raise ValueError("Canal PCA9685 fuera de 0..15")
        ticks = round(float(pulse_us) * self.frequency_hz * 4096 / 1_000_000)
        ticks = max(0, min(4095, ticks))
        register = LED0_ON_L + 4 * int(channel)
        off_high = (ticks >> 8) & 0x0F
        # Escribir los cuatro registros individualmente resulta más confiable
        # en la placa clon ensayada que una transferencia SMBus por bloque.
        self._write(register, 0)
        self._write(register + 1, 0)
        self._write(register + 2, ticks & 0xFF)
        self._write(register + 3, off_high)
        # Confirmar el byte alto: si se pierde, un pulso de 1500 us queda
        # truncado y el servo no recibe una orden válida.
        for _ in range(3):
            self._write(register + 3, off_high)
            if (self._read(register + 3) & 0x1F) == off_high:
                break
        else:
            raise OSError("El PCA9685 no confirmó el byte alto del pulso")

    def prepare_pulse_us(self, channel, pulse_us):
        """Precarga un pulso mientras OE y FULL_OFF mantienen todo apagado."""
        if self.armed:
            raise RuntimeError("Use set_pulse_us cuando el controlador está armado")
        self._write_pulse_us(channel, pulse_us)

    def prepare_channel_off(self, channel):
        """Deja un canal individual apagado antes de habilitar las salidas."""
        if self.armed:
            raise RuntimeError("El controlador debe estar desarmado")
        if not 0 <= int(channel) <= 15:
            raise ValueError("Canal PCA9685 fuera de 0..15")
        register = LED0_ON_L + 4 * int(channel)
        self._write_block(register, [0, 0, 0, FULL_OFF])

    def set_channel_off(self, channel):
        """Apaga un canal individual, incluso con el controlador armado."""
        if not 0 <= int(channel) <= 15:
            raise ValueError("Canal PCA9685 fuera de 0..15")
        register = LED0_ON_L + 4 * int(channel)
        self._write(register, 0)
        self._write(register + 1, 0)
        self._write(register + 2, 0)
        self._write(register + 3, FULL_OFF)

    def set_pulse_us(self, channel, pulse_us):
        if not self.armed:
            raise RuntimeError("PWM deshabilitado: primero debe armarse el controlador")
        self._write_pulse_us(channel, pulse_us)

    @staticmethod
    def angle_to_pulse(angle_rad, calibration):
        if not calibration.get("calibrated", False):
            raise RuntimeError("Servo sin calibrar")
        direction = int(calibration["direction"])
        center = float(calibration["center_us"])
        # La escala se define respecto de 90 grados desde el centro y siempre
        # queda saturada dentro de los pulsos medidos para esta articulación.
        half_range = min(center - float(calibration["min_us"]),
                         float(calibration["max_us"]) - center)
        pulse = center + direction * float(angle_rad) * half_range / (pi / 2)
        return max(float(calibration["min_us"]),
                   min(float(calibration["max_us"]), pulse))

    def close(self):
        self.all_off()
        self._bus.close()
        if self._gpio is not None:
            self._gpio.cleanup(self._oe_pin)
