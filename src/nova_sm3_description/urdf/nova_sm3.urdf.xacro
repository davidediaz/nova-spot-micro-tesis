<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nova_sm3">
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="use_mujoco" default="false"/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="include_ros2_control" default="true"/>

  <xacro:include filename="$(find nova_sm3_description)/urdf/nova_sm3.materials.xacro"/>
  <xacro:include filename="$(find nova_sm3_description)/urdf/nova_sm3.ros2_control.xacro"/>

  <!--
    PROVISIONAL REFERENCE MODEL — not yet a characterized digital twin.
    Published NovaSM3 v5.2b dimensions used here:
      hip pivot spacing: 0.180 m longitudinal x 0.120 m lateral
      coxa/shoulder: 0.090 m; femur: 0.105 m; tibia: 0.132 m
      total reference mass: about 2.72 kg
    Link cross-sections and mass distribution are engineering estimates. Joint
    limits below are conservative placeholders, NOT copied servo calibration.
  -->
  <xacro:property name="hip_spacing_x" value="0.180"/>
  <xacro:property name="hip_spacing_y" value="0.120"/>
  <xacro:property name="coxa_length" value="0.090"/>
  <xacro:property name="femur_length" value="0.105"/>
  <xacro:property name="tibia_length" value="0.132"/>
  <xacro:property name="body_length" value="0.230"/>
  <xacro:property name="body_width" value="0.120"/>
  <xacro:property name="body_height" value="0.075"/>

  <!-- Estimated distribution sums to the published approximate total 2.72 kg. -->
  <xacro:property name="body_mass" value="1.20"/>
  <xacro:property name="coxa_mass" value="0.12"/>
  <xacro:property name="femur_mass" value="0.12"/>
  <xacro:property name="tibia_mass" value="0.11"/>
  <xacro:property name="foot_mass" value="0.03"/>

  <xacro:macro name="box_inertial" params="mass x y z origin_x:=0 origin_y:=0 origin_z:=0">
    <inertial>
      <origin xyz="${origin_x} ${origin_y} ${origin_z}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12}" iyz="0"
               izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="nova_leg" params="prefix x y side">
    <link name="${prefix}_coxa_link">
      <visual><origin xyz="0 ${side*coxa_length/2} 0"/><geometry><box size="0.035 ${coxa_length} 0.035"/></geometry><material name="nova_black"/></visual>
      <collision><origin xyz="0 ${side*coxa_length/2} 0"/><geometry><box size="0.035 ${coxa_length} 0.035"/></geometry></collision>
      <xacro:box_inertial mass="${coxa_mass}" x="0.035" y="${coxa_length}" z="0.035" origin_y="${side*coxa_length/2}"/>
    </link>
    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/><child link="${prefix}_coxa_link"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="${side} 0 0"/>
      <!-- Placeholder mechanical envelope; replace after physical calibration. -->
      <limit lower="-0.60" upper="0.60" effort="1.0787315" velocity="6.981317"/>
      <dynamics damping="0.08" friction="0.03"/>
    </joint>

    <link name="${prefix}_femur_link">
      <visual><origin xyz="0 0 ${-femur_length/2}"/><geometry><box size="0.035 0.030 ${femur_length}"/></geometry><material name="nova_yellow"/></visual>
      <collision><origin xyz="0 0 ${-femur_length/2}"/><geometry><box size="0.035 0.030 ${femur_length}"/></geometry></collision>
      <xacro:box_inertial mass="${femur_mass}" x="0.035" y="0.030" z="${femur_length}" origin_z="${-femur_length/2}"/>
    </link>
    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/><child link="${prefix}_femur_link"/>
      <origin xyz="0 ${side*coxa_length} 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.20" upper="1.20" effort="1.0787315" velocity="6.981317"/>
      <dynamics damping="0.08" friction="0.03"/>
    </joint>

    <link name="${prefix}_tibia_link">
      <visual><origin xyz="0 0 ${-tibia_length/2}"/><geometry><box size="0.030 0.025 ${tibia_length}"/></geometry><material name="nova_black"/></visual>
      <collision><origin xyz="0 0 ${-tibia_length/2}"/><geometry><box size="0.030 0.025 ${tibia_length}"/></geometry></collision>
      <xacro:box_inertial mass="${tibia_mass}" x="0.030" y="0.025" z="${tibia_length}" origin_z="${-tibia_length/2}"/>
    </link>
    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/><child link="${prefix}_tibia_link"/>
      <origin xyz="0 0 ${-femur_length}"/><axis xyz="0 1 0"/>
      <limit lower="-2.20" upper="0.10" effort="1.0787315" velocity="6.981317"/>
      <dynamics damping="0.08" friction="0.03"/>
    </joint>

    <link name="${prefix}_foot_link">
      <visual><geometry><sphere radius="0.018"/></geometry><material name="nova_grey"/></visual>
      <collision name="${prefix}_foot_collision"><geometry><sphere radius="0.018"/></geometry></collision>
      <inertial><mass value="${foot_mass}"/><inertia ixx="0.0000039" ixy="0" ixz="0" iyy="0.0000039" iyz="0" izz="0.0000039"/></inertial>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_tibia_link"/><child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-tibia_length}"/>
    </joint>
    <xacro:if value="$(arg use_gazebo)">
      <gazebo reference="${prefix}_foot_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
      </gazebo>
      <gazebo reference="${prefix}_foot_link">
        <sensor name="${prefix}_contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>${prefix}_foot_link_fixed_joint_lump__${prefix}_foot_collision_collision</collision>
            <topic>/nova/contacts/${prefix}</topic>
          </contact>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <link name="base_link">
    <visual><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="nova_yellow"/></visual>
    <collision><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
    <xacro:box_inertial mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0"/></joint>

  <xacro:nova_leg prefix="front_left"  x="${ hip_spacing_x/2}" y="${ hip_spacing_y/2}" side="1"/>
  <xacro:nova_leg prefix="front_right" x="${ hip_spacing_x/2}" y="${-hip_spacing_y/2}" side="-1"/>
  <xacro:nova_leg prefix="rear_left"   x="${-hip_spacing_x/2}" y="${ hip_spacing_y/2}" side="1"/>
  <xacro:nova_leg prefix="rear_right"  x="${-hip_spacing_x/2}" y="${-hip_spacing_y/2}" side="-1"/>

  <xacro:if value="$(arg include_ros2_control)">
    <xacro:nova_ros2_control use_fake_hardware="$(arg use_fake_hardware)" use_mujoco="$(arg use_mujoco)" use_gazebo="$(arg use_gazebo)" headless="$(arg headless)"/>
  </xacro:if>
  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find nova_sm3_description)/config/controllers.yaml</parameters>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
